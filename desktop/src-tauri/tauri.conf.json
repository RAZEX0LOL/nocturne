{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nocturne",
  "version": "1.0.0",
  "identifier": "app.nocturne.music",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Nocturne",
        "width": 1180,
        "height": 800,
        "minWidth": 720,
        "minHeight": 560,
        "theme": "Dark",
        "backgroundColor": "#0B0B10",
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http: https: asset: http://asset.localhost; media-src 'self' blob: http: https: asset: http://asset.localhost; connect-src 'self' http: https: ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$AUDIO/Nocturne/**",
          "$APPLOCALDATA/downloads/**",
          "$APPCACHE/covers/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "deb",
      "appimage",
      "msi",
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Клиент Navidrome",
    "longDescription": "Слушай свою музыку с домашнего сервера Navidrome или прямо с этого компьютера.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://nocturne.example.com/nocturne/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFQjQ0OTkyMDZEQzcxNTkKUldSWmNkd0dra20wUGdqZVlGTnE4NzB2RFNXYk5UWnFkUnlNRDN5N0x5OEoxTHZQNnR3VDZGUDgK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
