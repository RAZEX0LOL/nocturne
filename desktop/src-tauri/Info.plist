<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Navidrome в домашней сети часто работает по обычному HTTP (192.168.x.x, *.local), и приложение
		это разрешает (shared/spec). Без этого ключа macOS блокирует такие запросы целиком.
		Внешние адреса по-прежнему только HTTPS.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
