{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Nocturne Player",
        "width": 1180,
        "height": 800,
        "minWidth": 720,
        "minHeight": 560,
        "theme": "Dark",
        "transparent": true,
        "windowEffects": {
          "effects": ["mica"]
        },
        "backgroundThrottling": "disabled",
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,HardwareMediaKeyHandling"
      }
    ]
  },
  "bundle": {
    "publisher": "Nocturne",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      },
      "wix": {
        "upgradeCode": "eaa1f146-7d1d-5c62-ba8b-c73f0d60d57a",
        "language": ["ru-RU", "en-US"]
      }
    }
  }
}
