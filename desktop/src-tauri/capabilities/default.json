{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Права главного окна: открыть ссылку в браузере, показать папку музыки, системный выбор файлов.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$AUDIO/Nocturne"
        },
        {
          "path": "$AUDIO/Nocturne/**"
        }
      ]
    },
    "opener:allow-open-url",
    "dialog:allow-open"
  ]
}